# Copie para .env e preencha. O .env nunca deve ser versionado (ja esta no .gitignore).
# Chaves deixadas em branco sao ignoradas.

# Configuracao (nao sao segredos)
# CEV_MODO_DEMO: em branco = modo demonstracao; 0 = grava na planilha de verdade
CEV_MODO_DEMO=
MAX_CICLOS=
INTERVALO_SEGUNDOS=

# Credenciais (lidas por obter_credencial() em comodato_sheet.R)
GOOGLE_SHEETS_EMAIL=
PLANILHA_URL=
